<Project Sdk="Microsoft.NET.Sdk">

  <!--
    V4 candidate "bounded conquest with a recoverable kingdom" (plan chapter of the same name):
    seasonal shards, border challenges with reservations, offline defence through the existing
    AK-TR-1 bots, the PROPOSED protection/army/newcomer table, alliances and season close.
    Server-side domain logic only (no networking, no storage engine). Same constraints as the rules
    assembly: netstandard2.1, C# 9, no UnityEngine, no System.Random, no floating point; time is
    injected as UTC milliseconds.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AstraKingdoms.World</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests seed experience counters directly (RecordWorldEncounter is otherwise shard-only). -->
    <InternalsVisibleTo Include="AstraKingdoms.World.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstraKingdoms.Rules\AstraKingdoms.Rules.csproj" />
  </ItemGroup>

</Project>
