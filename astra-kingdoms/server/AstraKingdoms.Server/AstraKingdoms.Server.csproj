<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Authoritative online match service for Astra Kingdoms V1 (online tickets 49-56).
    Hosts the shared rules assembly (MatchEngine) unchanged; clients never write HP, land, locks,
    rewards or results. The realtime protocol sources are compiled from the Unity client folder
    (unity/Assets/Scripts/Online/Protocol) so the message schema cannot drift between the two.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AstraKingdoms.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AstraKingdoms.Rules\AstraKingdoms.Rules.csproj" />
    <ProjectReference Include="..\..\tools\UnityCompileCheck\OnlineProtocol\AstraKingdoms.Client.Online.Protocol.Check.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstraKingdoms.Server.Tests" />
  </ItemGroup>

</Project>
