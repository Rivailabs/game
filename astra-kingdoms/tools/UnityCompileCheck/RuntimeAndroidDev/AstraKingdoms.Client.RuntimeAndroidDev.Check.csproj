<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile check of unity/Assets/Scripts/Runtime against tools/UnityStubs.
    Variant: Android development build (automation interface, intent extras, legacy input module).
    Defines: UNITY_ANDROID;DEVELOPMENT_BUILD;ENABLE_LEGACY_INPUT_MANAGER;UNITY_6000_0_OR_NEWER
  -->
  <Import Project="../UnityCheck.props" />

  <PropertyGroup>
    <AssemblyName>AstraKingdoms.Client.RuntimeAndroidDev</AssemblyName>
    <RootNamespace>AstraKingdoms.Client</RootNamespace>
    <DefineConstants>$(DefineConstants);UNITY_ANDROID;DEVELOPMENT_BUILD;ENABLE_LEGACY_INPUT_MANAGER;UNITY_6000_0_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(AkUnityAssets)Scripts/Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(AkRules)" />
    <ProjectReference Include="$(AkStubs)" />
    <ProjectReference Include="../Core/AstraKingdoms.Client.Core.Check.csproj" />
  </ItemGroup>

</Project>
