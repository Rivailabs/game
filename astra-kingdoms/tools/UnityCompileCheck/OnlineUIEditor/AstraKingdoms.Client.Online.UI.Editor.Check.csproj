<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile check of unity/Assets/Scripts/Online/UI (the AstraKingdoms.Client.Online.UI asmdef)
    against tools/UnityStubs and the Editor-variant runtime assembly.
    Defines: UNITY_EDITOR;DEVELOPMENT_BUILD;ENABLE_INPUT_SYSTEM;UNITY_6000_0_OR_NEWER
    (development sign-in fallback compiled in).
  -->
  <Import Project="../UnityCheck.props" />

  <PropertyGroup>
    <AssemblyName>AstraKingdoms.Client.Online.UI.Editor</AssemblyName>
    <RootNamespace>AstraKingdoms.Client.Online.UI</RootNamespace>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;DEVELOPMENT_BUILD;ENABLE_INPUT_SYSTEM;UNITY_6000_0_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(AkUnityAssets)Scripts/Online/UI/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(AkRules)" />
    <ProjectReference Include="$(AkStubs)" />
    <ProjectReference Include="../Core/AstraKingdoms.Client.Core.Check.csproj" />
    <ProjectReference Include="../RuntimeEditor/AstraKingdoms.Client.RuntimeEditor.Check.csproj" />
    <ProjectReference Include="../Online/AstraKingdoms.Client.Online.Check.csproj" />
    <ProjectReference Include="../OnlineProtocol/AstraKingdoms.Client.Online.Protocol.Check.csproj" />
  </ItemGroup>

</Project>
